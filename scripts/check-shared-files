#!/usr/bin/env bash
# Files that are one file kept in several repositories must stay one file. The owner of each is named here; every other
# copy is compared with it and any difference fails, so a change is made once, at its owner, and copied.
#
#   scripts/check-shared-files               compare this repository's copies with their owners'
#   PURLAY_OFFLINE=1 scripts/check-shared-files   skip (no network): never set in CI
#
# Owners: `purlay/purlay` (the server) for licence, contributor agreement, security policy and editor settings;
#         `purlay/purlay-swift` for what the Swift repositories share: format rules, NOTICE and this script.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ "${PURLAY_OFFLINE:-}" = "1" ]; then echo "check-shared-files: skipped (PURLAY_OFFLINE=1)"; exit 0; fi

RAW=https://raw.githubusercontent.com/purlay
scratch="$(mktemp -d)"; trap 'rm -rf "$scratch"' EXIT
failed=0

compare() { # owner path
  local owner="$1" path="$2"
  [ -f "$path" ] || { echo "MISSING  $path (owned by $owner)" >&2; failed=1; return; }
  if ! curl -fsSL --retry 2 "$RAW/$owner/main/$path" -o "$scratch/file"; then
    echo "FAIL: cannot read $owner/$path" >&2; failed=1; return
  fi
  if cmp -s "$scratch/file" "$path"; then echo "ok       $path"; else echo "DIFFERS  $path (owned by $owner)" >&2; failed=1; fi
}

for path in LICENSE CLA.md SECURITY.md .editorconfig; do compare purlay "$path"; done
for path in .swift-format NOTICE scripts/check-shared-files; do compare purlay-swift "$path"; done
exit $failed
