#!/usr/bin/env bash
# Everything the pipeline checks. One script, in lanes, so that CI runs the lanes side by side and a person runs them all.
#
#   scripts/verify            every lane, in order
#   scripts/verify rules      branch name, shared files, architecture rules and their demonstration   (no Swift needed)
#   scripts/verify generated  format, the pinned contract, the generated code, the generator          (needs Contract/bundle)
#   scripts/verify test       format and the tests on macOS                                           (needs Contract/bundle)
#   scripts/verify ios        a build for iOS 18 and later
#   scripts/verify security   the history holds no secret (gitleaks, pinned: scripts/install-gitleaks)      (needs network the first time)
#
# Compilation is cached by content (Xcode's compilation cache) in PURLAY_CACHE_DIR, so a build in a fresh checkout reuses
# what an earlier one compiled; CI keeps that directory between runs.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

CAS="${PURLAY_CACHE_DIR:-$HOME/Library/Caches/dev.purlay/compilation-cache}"
# xcodebuild's -quiet hides what a failed test asserted, so the output is kept and, on a failure, the lines that say what failed
# are printed with the end of it.
xcb() {
  local log status=0
  log="$(mktemp)"
  xcodebuild -scheme purlay-swift-Package "$@" \
    COMPILATION_CACHE_ENABLE_CACHING=YES COMPILATION_CACHE_CAS_PATH="$CAS" \
    COMPILER_INDEX_STORE_ENABLE=NO CODE_SIGNING_ALLOWED=NO >"$log" 2>&1 || status=$?
  if [ "$status" -ne 0 ]; then
    grep -E "error:|✘|recorded an issue|Expectation failed|Failing tests|\*\* (TEST|BUILD) FAILED" "$log" | sort -u | head -40 >&2 || true
    echo "--- the end of the log:" >&2
    tail -25 "$log" >&2
  fi
  rm -f "$log"
  return "$status"
}

rules() {
  step "branch name"
  scripts/check-branch
  step "shared files are the owners' copies"
  scripts/check-shared-files
  step "architecture rules, and the demonstration that each one refuses its violation"
  scripts/enforcement
  scripts/enforcement --demo
}

generated() {
  format
  step "the contract bundle is the one the lock pins, and the generated code is what it generates"
  scripts/contract verify
  scripts/generate --check
  step "the generator: build and test"
  (cd Tools/PurlayGen && swift test 2>&1 | grep -q "Test run with .* passed") || { echo "FAIL: Tools/PurlayGen" >&2; exit 1; }
}

format() {
  step "format"
  find Sources Tests ContractTests Tools -name '*.swift' -not -path '*/.build/*' -not -path '*/Generated/*' -print0 \
    | xargs -0 xcrun swift-format lint --strict --parallel
}

tests() { # -only-testing arguments, or none for every test
  step "tests on macOS, Swift 6, every warning an error"
  xcb -destination 'platform=macOS' "$@" test
}

ios() {
  step "builds for iOS 18 and later"
  xcb -destination 'generic/platform=iOS Simulator' build
}

security() {
  step "no secret in the history"
  scripts/install-gitleaks
  if ! command -v gitleaks >/dev/null 2>&1; then
    # Just installed by the script above, into a directory that is on the PATH of the steps that follow in CI but not of this one.
    PATH="${GITLEAKS_HOME:-$HOME/.local/share/purlay/gitleaks-$(sed -n 's/^VERSION=//p' scripts/install-gitleaks)}:$PATH"
  fi
  command -v gitleaks >/dev/null 2>&1 || { echo "FAIL: gitleaks is not available, so the history was not scanned" >&2; exit 1; }
  gitleaks git --no-banner
}

case "${1:-all}" in
  rules) rules ;;
  generated) generated ;;
  test) format; tests ;;
  test-contract) tests -only-testing:PurlayContractTests -only-testing:PurlayTokensTests ;;
  test-kit) tests -only-testing:PurlayKitTests -only-testing:PurlayTestSupportTests ;;
  ios) ios ;;
  security) security ;;
  all) rules; generated; tests; ios; security ;;
  *) echo "usage: scripts/verify [rules|generated|test|test-contract|test-kit|ios|security]" >&2; exit 2 ;;
esac

printf '\n\033[1mverify %s: everything passed\033[0m\n' "${1:-all}"
