#!/usr/bin/env bash
# Everything the pipeline checks. One script, in lanes, so that CI runs the lanes side by side and a person runs them all.
#
#   scripts/verify            every lane, in order
#   scripts/verify rules      branch name, shared files, architecture rules and their demonstration   (no Swift needed)
#   scripts/verify generated  the pinned contract, the generated code, the generator                  (needs Contract/bundle)
#   scripts/verify test       format and the tests on macOS                                           (needs Contract/bundle)
#   scripts/verify ios        a build for iOS 18 and later
#
# Compilation is cached by content (Xcode's compilation cache) in PURLAY_CACHE_DIR, so a build in a fresh checkout reuses
# what an earlier one compiled; CI keeps that directory between runs.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

CAS="${PURLAY_CACHE_DIR:-$HOME/Library/Caches/dev.purlay/compilation-cache}"
xcb() {
  xcodebuild -scheme purlay-swift-Package "$@" \
    COMPILATION_CACHE_ENABLE_CACHING=YES COMPILATION_CACHE_CAS_PATH="$CAS" \
    COMPILER_INDEX_STORE_ENABLE=NO CODE_SIGNING_ALLOWED=NO -quiet
}

rules() {
  step "branch name"
  scripts/check-branch
  step "shared files are the owners' copies"
  scripts/check-shared-files
  step "architecture rules, and the demonstration that each one refuses its violation"
  scripts/enforcement
  scripts/enforcement --demo
}

generated() {
  step "the contract bundle is the one the lock pins, and the generated code is what it generates"
  scripts/contract verify
  scripts/generate --check
  step "the generator: build and test"
  (cd Tools/PurlayGen && swift test 2>&1 | grep -q "Test run with .* passed") || { echo "FAIL: Tools/PurlayGen" >&2; exit 1; }
}

tests() {
  step "format"
  find Sources Tests ContractTests Tools -name '*.swift' -not -path '*/.build/*' -not -path '*/Generated/*' -print0 \
    | xargs -0 xcrun swift-format lint --strict --parallel
  step "tests on macOS, Swift 6, every warning an error"
  xcb -destination 'platform=macOS' test
}

ios() {
  step "builds for iOS 18 and later"
  xcb -destination 'generic/platform=iOS Simulator' build
}

case "${1:-all}" in
  rules) rules ;;
  generated) generated ;;
  test) tests ;;
  ios) ios ;;
  all) rules; generated; tests; ios ;;
  *) echo "usage: scripts/verify [rules|generated|test|ios]" >&2; exit 2 ;;
esac

printf '\n\033[1mverify %s: everything passed\033[0m\n' "${1:-all}"
