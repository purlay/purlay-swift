#!/usr/bin/env bash
# Contract/bundle, taken from the server release Contract/contract.lock names, unless it is already there and is that bundle.
# The bundle is a few hundred kilobytes and a pure function of the lock, so CI caches it by the lock's digest and this runs
# only on a miss.
#
#   scripts/prepare-contract
#
# The server publishes the bundle with each release (`purlay-contract-vX.Y.Z.tar.gz` and its digest). An older release that has
# none is built from its source instead. Either way the result must be the bundle the lock pins: `scripts/contract fetch` and
# `use` re-write the lock, so the lock is compared before and after and any change fails, rather than being re-pinned quietly.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ -d Contract/bundle ] && scripts/contract verify >/dev/null 2>&1; then echo "contract bundle: already the pinned one"; exit 0; fi

version=$(python3 -c 'import json; print(json.load(open("Contract/contract.lock"))["serverVersion"])')
before="$(cat Contract/contract.lock)"

if scripts/contract fetch "v$version" >/dev/null 2>&1; then
  echo "contract bundle: taken from the server's v$version release"
else
  echo "contract bundle: v$version has no published bundle; building it from the release's source"
  work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
  git clone --quiet --depth 1 --branch "v$version" "https://github.com/${PURLAY_SERVER_REPOSITORY:-purlay/purlay}.git" "$work/server"
  (cd "$work/server" && bun install --frozen-lockfile >/dev/null && bun run contract:bundle --out "$work/bundle" >/dev/null)
  scripts/contract use "$work/bundle" >/dev/null
fi

[ "$(cat Contract/contract.lock)" = "$before" ] || {
  echo "FAIL: the bundle is not the one Contract/contract.lock pins; the lock was restored" >&2
  printf '%s\n' "$before" > Contract/contract.lock
  exit 1
}
scripts/contract verify
